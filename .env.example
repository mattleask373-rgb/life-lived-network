# Copy this file to .env for local development; never commit .env.
# Use only the public/publishable Supabase key in browser-facing configuration.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server runtime equivalents; configure these in your hosting environment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# Optional/server-only credentials belong in the secret manager or local .env only.
# Never use a service-role key in client code or commit real secrets.
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
# TICKETMASTER_API_KEY=
